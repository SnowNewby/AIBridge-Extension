{
  "manifest_version": 3,
  "name": "AI Bridge for Yandex Disk",
  "version": "1.0.0",
  "description": "Чат-клиент поверх Яндекс.Диска: отправляет запросы домашнему AI Bridge Worker через файлы.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://cloud-api.yandex.net/*",
    "https://disk.yandex.ru/*",
    "https://oauth.yandex.ru/*",
    "https://*.yandex.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://disk.yandex.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oauth.yandex.ru/verification_code*"
      ],
      "js": [
        "oauth-callback.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat.html",
        "chat.js",
        "chat.css"
      ],
      "matches": [
        "https://disk.yandex.ru/*"
      ]
    }
  ],
  "action": {
    "default_title": "AI Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}